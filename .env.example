# Canonical production origin (no trailing slash). Used for metadata, Open Graph,
# sitemap.xml, robots.txt, and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Booking form delivery adapter ---
# Server-to-server endpoint that receives validated booking submissions as JSON,
# schedules the meeting, and triggers the confirmation email. Until this is set,
# POST /api/booking intentionally returns HTTP 503 and the UI clearly states that
# nothing was submitted. See README.md "Connecting the booking form".
BOOKING_WEBHOOK_URL=

# Optional shared secret sent as a Bearer token to BOOKING_WEBHOOK_URL.
BOOKING_WEBHOOK_TOKEN=

# --- Contact form delivery adapter ---
# Server-to-server endpoint (CRM, helpdesk, or transactional email API) that
# receives validated contact submissions as JSON. Until this is set, POST
# /api/contact intentionally returns HTTP 503.
CONTACT_WEBHOOK_URL=

# Optional shared secret sent as a Bearer token to CONTACT_WEBHOOK_URL.
CONTACT_WEBHOOK_TOKEN=
