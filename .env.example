# Canonical production origin (no trailing slash). Used for metadata, Open Graph,
# sitemap.xml, robots.txt, and JSON-LD. On Railway it falls back to the service's
# public domain if unset.
NEXT_PUBLIC_SITE_URL=https://martex.com.lr

# --- Form delivery by email (recommended) ---
# Booking requests and contact messages are emailed to FORMS_INBOX_EMAIL through
# Resend (https://resend.com). See DEPLOYMENT.md, step 2.
RESEND_API_KEY=
# Where submissions are delivered. Comma-separate several addresses if needed.
FORMS_INBOX_EMAIL=
# Sender address on a domain verified in Resend, e.g. "MartEX <bookings@martex.com.lr>".
# Leave empty until the domain is verified: Resend's shared test sender is used,
# which can only deliver to the email address that owns the Resend account, and
# visitors don't get a confirmation email until this is set.
EMAIL_FROM=

# --- Optional: also forward submissions to your own systems ---
# Booking: forwarded as multipart/form-data (including the uploaded file) with a
# generated "reference" field. Contact: forwarded as JSON.
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_TOKEN=
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
